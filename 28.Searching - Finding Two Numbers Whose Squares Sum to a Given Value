import java.util.*;

public class Solution {
    public static void main(String[] args) {
        
        Scanner sc = new Scanner(System.in);
        int c = sc.nextInt();//5

        for (long a = 0; a * a <= c; a++) {

            long left = 0;//5
            long right = c;//5
            long target = c - (a * a);//5-(0*0)=5-0=5//


            while (left <= right) {//0<5//5
                long mid = (left + right) / 2;//0+5/2=2
                long square = mid * mid;//4

                if (square == target) {//4==5|5==5
                    System.out.println(true);
                    return;   
                } 
                else if (square < target) {//4<5
                    left = mid + 1;//5
                } 
                else {
                    right = mid - 1;
                }
            }
        }

        System.out.println(false);
    }
}
