import java.util.Scanner;

public class solution  {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long n = sc.nextLong();

        long count = 0;

        while (n > 0) {
            n = n / 5;
            count = count + n;
        }

        System.out.println(count);
    }
}
