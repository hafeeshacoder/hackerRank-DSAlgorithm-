import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) 
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();//6
        int[]arr=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=sc.nextInt();//5 7 7 8 8 10 
        }
        
        int x=sc.nextInt();//8
        int first=-1;
        int last=-1;
        int low=0;
        int high=n-1;
        while(low<=high)//0<=5
        {
            int mid=(low+high)/2;//4
            if(arr[mid]==x)
            {
                first=mid;//4
                high=mid-1;//4-1=3
            }
            else if(arr[mid]<x)//4<8
            {
                low=mid+1;
            }
            else
            {
                high=mid-1;//4-1=3
            }
        }
        low=0;
        high=n-1;//5
        while(low<=high)//0<5
        {
            int mid=(low+high)/2;//(0+5)/2=2
            if(arr[mid]==x)
            {
                last=mid;//last=2
                low=mid+1;//low=2+1=3
            }
             else if(arr[mid]<x)
            {
                low=mid+1;
            }
            else
            {
                high=mid-1;//2-1=1
            }
        }
        System.out.println("["+first+", "+last+"]");
    }
}
