import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) 
    {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();//36
        for(int i=1;i<=n;i++)
        {
            if(n%i==0)//1%36 2%36
            {
                System.out.print(i+" ");// 1 2 3 4 6 9 12 18 36
            }
        }
    }
}
